<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <style>
        :root {
    --primary: #4A90E2;
    --primary-dark: #357ABD;
    --secondary: #7b5fc0;
    --bg: #f4f6fb;
    --card-bg: #ffffff;
    --text-dark: #1f2933;
    --text-light: #6b7280;
    --border: #e5e7eb;
    --shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
}

* {
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    margin: 0;
    padding: 0;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f9fafb);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-dark);
}

/* Page title */
h1 {
    margin-bottom: 30px;
    font-size: 2.1rem;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* Admin login shortcut */
#admin-form {
    position: absolute;
    top: 25px;
    right: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(6px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#admin-form:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.15);
}

/* Admin link */
#admin-btn {
    font-size: 0.95rem;
    font-weight: 600;
    color: #54808C;
    text-decoration: none;
    transition: color 0.2s ease;
}

#admin-btn:hover {
    color: #fa4343;
    text-decoration: underline;
}

/* Login card */
#login-container {
    width: 50vw;
    max-width: 480px;
    min-width: 360px;
    padding: 35px 30px;
    background: var(--card-bg);
    border-radius: 16px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    animation: fadeIn 0.5s ease;
}

/* Form */
#login-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

/* Form rows */
#login-form .box {
    display: flex;
    align-items: center;
    gap: 14px;
}

/* Labels */
#login-form label {
    width: 35%;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-light);
    text-align: right;
}

/* Inputs */
#login-form input {
    flex: 1;
    padding: 10px 12px;
    font-size: 0.95rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    outline: none;
    transition: border 0.2s ease, box-shadow 0.2s ease;
}

#login-form input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}

/* Login button */
#login-btn {
    margin-top: 10px;
    align-self: center;
    width: 140px;
    height: 42px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--secondary), var(--primary));
    color: white;
    border: none;
    cursor: pointer;
    letter-spacing: 0.3px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(123, 95, 192, 0.35);
}

#login-btn:active {
    transform: translateY(0);
    box-shadow: none;
}

/* Signup section */
p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-light);
}

#signup-btn {
    background: none;
    border: none;
    padding: 0;
    margin-left: 4px;
    cursor: pointer;
    font-size: 0.9rem;
}

#signup-btn a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
}

#signup-btn a:hover {
    text-decoration: underline;
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@media (max-width: 600px) {
    h1 {
        font-size: 1.7rem;
    }

    #login-container {
        width: 90vw;
        min-width: unset;
        padding: 28px 22px;
    }

    #login-form .box {
        flex-direction: column;
        align-items: flex-start;
    }

    #login-form label {
        width: 100%;
        text-align: left;
    }

    #admin-form {
        position: static;
        margin-bottom: 20px;
    }
}

    </style>
</head>

<body>
    <h1>Login Page</h1>

    <form action="get" method="/admin/login" id="admin-form">
        <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#54808C">
            <path
                d="M690.88-270q25.88 0 44-19T753-333.88q0-25.88-18.12-44t-44-18.12Q665-396 646-377.88q-19 18.12-19 44T646-289q19 19 44.88 19Zm-1.38 125q33.5 0 60.5-14t46-40q-26-14-51.96-21t-54-7q-28.04 0-54.54 7T584-199q19 26 45.5 40t60 14ZM480-80q-138-32-229-156.5T160-522v-239l320-120 320 120v270q-14-7-30-12.5t-30-7.5v-208l-260-96-260 96v197q0 76 24.5 140T307-269.5q38 48.5 84 80.5t89 46q6 12 18 27t20 23q-9 5-19 7.5T480-80Zm212.5 0Q615-80 560-135.5T505-267q0-78.43 54.99-133.72Q614.98-456 693-456q77 0 132.5 55.28Q881-345.43 881-267q0 76-55.5 131.5T692.5-80ZM480-479Z" />
        </svg>
        <a id="admin-btn" href="/admin-login">admin Login</a>
    </form>

    <div id="login-container">
        <form action="/user-login" method="POST" id="login-form">
            <div class="box">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="box">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" id="login-btn">Login</button>
        </form>

        <p>Don't have an account? <button type="submit" id="signup-btn"><a href="/signup">Sign Up</a></button></p>
    </div>
</body>

</html>