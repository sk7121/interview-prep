<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            padding: 50px;
        }

        #login-form {
            width: 50vw;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            gap: 2.5vh;
        }

        #login-form .box {
            display: flex;
            flex-direction: row;
            gap: 20%;
            margin-bottom: 15px;
            width: 60%;
            min-width: 300px;
        }

        #login-form label {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            width: 40%;
            font-size: 1.2rem;
        }

        #login-form input {
            width: 60%;
            height: 4vh;
            align-items: center;
            font-size: 1.2rem;
            border-radius: 5px;
            padding: 1%;
            border: none;
        }

        #login-form input:focus {
            border: none;
            outline: 2px solid #4A90E2;
            background-color: white;
        }

        #login-btn {
            width: 16%;
            height: 5.5vh;
            align-self: center;
            cursor: pointer;
            padding: 1%;
            border-radius: 5px;
            background-color: #d2c6f1;
            border: none;
            min-width: 100px;
            transition: 0.5s;
        }

        #login-btn:hover {
            background-color: #7b5fc0;
            color: white;
            box-shadow: 1px 1px 1px black;
        }

        h1 {
            margin-bottom: 10vh;
            text-decoration: underline;
        }

        #admin-btn {
            font-size: large;
            background: none;
            border: none;
            cursor: pointer;
            color: rgb(84, 128, 140);
            transition: 0.5s;
            text-decoration: none;
        }

        #admin-btn:hover {
            color: rgb(250, 67, 67);
            border-radius: 10px;
            padding: 1px;
            text-decoration: underline;

        }

        #admin-form {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: absolute;
            right: 5px;
            background-color: transparent;
            padding: 1%;
            min-width: 100px;
            border-radius: 8%;
            transition: 0.5s;
        }

        #admin-form:hover {
            scale: 1.04;
            background-color: #d4e9eb;
        }

        #signup-btn {
            font-size: medium;
            background: none;
            border: none;
            cursor: pointer;
            color: #4A90E2;
            border-radius: 5px;
            padding: 1px;
            transition: 0.5s;
        }

        #signup-btn:hover {
            text-decoration: underline;
            box-shadow: 1px 1px 1px black;
        }

        #login-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3vh;
            padding: 5%;
            border-radius: 5px;
            min-width: 350px;
            background: linear-gradient(45deg, rgb(143 137 137), transparent);
        }
    </style>
</head>

<body>
    <h1>Login Page</h1>

    <form action="get" method="/admin/login" id="admin-form">
        <svg xmlns="http://www.w3.org/2000/svg" height="48px" viewBox="0 -960 960 960" width="48px" fill="#54808C">
            <path
                d="M690.88-270q25.88 0 44-19T753-333.88q0-25.88-18.12-44t-44-18.12Q665-396 646-377.88q-19 18.12-19 44T646-289q19 19 44.88 19Zm-1.38 125q33.5 0 60.5-14t46-40q-26-14-51.96-21t-54-7q-28.04 0-54.54 7T584-199q19 26 45.5 40t60 14ZM480-80q-138-32-229-156.5T160-522v-239l320-120 320 120v270q-14-7-30-12.5t-30-7.5v-208l-260-96-260 96v197q0 76 24.5 140T307-269.5q38 48.5 84 80.5t89 46q6 12 18 27t20 23q-9 5-19 7.5T480-80Zm212.5 0Q615-80 560-135.5T505-267q0-78.43 54.99-133.72Q614.98-456 693-456q77 0 132.5 55.28Q881-345.43 881-267q0 76-55.5 131.5T692.5-80ZM480-479Z" />
        </svg>
        <a id="admin-btn" href="/admin-login">admin Login</a>
    </form>

    <div id="login-container">
        <form action="/user-login" method="POST" id="login-form">
            <div class="box">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="box">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" id="login-btn">Login</button>
        </form>

        <p>Don't have an account? <button type="submit" id="signup-btn"><a href="/signup">Sign Up</a></button></p>
    </div>


</body>

</html>