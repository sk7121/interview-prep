<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Query Page</title>
  <style>
    :root {
      --primary: #4A90E2;
      --primary-dark: #357ABD;
      --bg: #f4f6fb;
      --card-bg: #ffffff;
      --text-dark: #1f2933;
      --text-light: #6b7280;
      --border: #e5e7eb;
      --shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 40px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 25px;
      font-family: "Inter", "Segoe UI", Arial, sans-serif;
      background: linear-gradient(135deg, #eef2ff, #f9fafb);
      color: var(--text-dark);
    }

    /* Page title */
    h1 {
      font-size: 2rem;
      font-weight: 600;
      letter-spacing: 0.4px;
      margin-bottom: 5px;
    }

    /* Form card */
    form {
      width: 65vw;
      max-width: 720px;
      min-width: 360px;
      padding: 35px 30px;
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 30px;
      animation: fadeIn 0.5s ease;
    }

    /* Section heading */
    form h2 {
      margin: 0;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--text-light);
    }

    /* Form rows */
    .box {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    /* Labels */
    label {
      width: 40%;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-dark);
    }

    /* Select */
    select {
      flex: 1;
      padding: 10px 12px;
      font-size: 0.95rem;
      border-radius: 8px;
      border: 1px solid var(--border);
      outline: none;
      transition: border 0.2s ease, box-shadow 0.2s ease;
    }

    select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
    }

    /* Radio group */
    input[type="radio"] {
      accent-color: var(--primary);
      cursor: pointer;
      transform: scale(1.1);
      margin-left: 8px;
      margin-right: 4px;
    }

    /* Submit button */
    button {
      align-self: center;
      width: 160px;
      height: 44px;
      font-size: 1rem;
      font-weight: 600;
      border-radius: 10px;
      border: none;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: white;
      cursor: pointer;
      letter-spacing: 0.4px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 15px 30px rgba(74, 144, 226, 0.35);
    }

    button:active {
      transform: translateY(0);
      box-shadow: none;
    }

    /* Animations */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Responsive */
    @media (max-width: 600px) {
      h1 {
        font-size: 1.6rem;
      }

      form {
        width: 90vw;
        min-width: unset;
        padding: 28px 22px;
      }

      .box {
        flex-direction: column;
        align-items: flex-start;
      }

      label {
        width: 100%;
      }
    }

    .radio-inputs,
    .radio-input {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 10px;
    }

    .radio-input {
      flex-direction: row;
      align-items: center;
      gap: 20px;
      justify-content: flex-start;
    }
  </style>
</head>

<body>
  <h1>Query Page</h1>
  <form action="/query-page/query" method="POST">
    <h2>Fill Details >></h2>

    <div class="box">
      <label for="interviewType">Interview Type :</label>
      <select name="interviewType" id="interviewType">
        <option value="technical">Technical</option>
        <option value="behavioral">Behavioral</option>
        <option value="managerial">Managerial</option>
        <option value="case-study">Case Study</option>
      </select>
    </div>
    <div class="box">
      <label for="difficulty">Experience Level :</label>
      <div class="radio-inputs">
        <div class="radio-input"><input type="radio" id="difficulty" name="difficulty" value="beginner" required>
          Beginner</div>
        <div class="radio-input"><input type="radio" id="difficulty" name="difficulty" value="intermediate" required>
          Intermediate</div>
        <div class="radio-input"><input type="radio" id="difficulty" name="difficulty" value="advanced" required>
          Advanced</div>
      </div>
    </div>
    <br>
    <button type="submit">Submit</button>
  </form>
</body>

</html>