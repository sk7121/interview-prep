<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Query Page</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            font-family: Arial, sans-serif;
            background-color: #f0f2f5;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 30px;
            width: 65vw;
            padding: 20px;
            font-size: 15px;
            background: linear-gradient(to right, #8daac9, #bacbdb, #8daac9);
            border-radius: 8px;
            min-width: 350px;
        }

        form button {
            align-self: center;
        }

        .box {
            display: flex;
            flex-direction: row;
            gap: 20px;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;

        }

        button {
            cursor: pointer;
        }

        label {
            width: 50%;
            display: flex;
            justify-content: center;
        }

        input[type="radio"] {
            width: 50%;
            display: flex;
            justify-content: flex-start;
        }

        input:focus {
            outline: none;
            border: 2px solid deepskyblue;
        }

        input[type="radio"] {
            width: auto;
            height: auto;
        }

        button {
            width: 150px;
            height: 50px;
            border-radius: 5px;
            border: none;
            background-color: lightblue;
        }

        button:hover {
            background-color: deepskyblue;
        }

        h1 {
            text-decoration: underline;
        }

        select {
            width: 38.4%;
            padding: 5px;
            font-size: 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
    </style>
</head>

<body>
    <h1>Query Page</h1>
    <form action="/query-page/query/<%=id%>" method="POST">
        <h2>Fill Details >></h2>

        <div class="box">
            <label for="interviewType">Interview Type :</label>
            <select name="interviewType" id="interviewType">
                <option value="technical">Technical</option>
                <option value="behavioral">Behavioral</option>
                <option value="managerial">Managerial</option>
                <option value="case-study">Case Study</option>
            </select>
        </div>
        <div class="box">
            <label for="difficulty">Experience Level :</label>
            <input type="radio" id="difficulty" name="difficulty" value="beginner" required>
            Beginner
            <input type="radio" id="difficulty" name="difficulty" value="intermediate" required>
            Intermediate
            <input type="radio" id="difficulty" name="difficulty" value="advanced" required>
            Advanced
        </div>
        <br>
        <button type="submit">Submit</button>
    </form>
</body>

</html>