<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Take Quiz</title>
    <style>
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .container {
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            width: 50vw;
        }

        .box {
            padding: 0 1rem;
            background-color: rgba(158, 212, 214, 0.582);
            border-radius: 5px;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;

        }

        #submit {
            width: 7vw;
            padding: 1rem;
            border: none;
            border-radius: 8px;
            background-color: rgba(146, 192, 234, 0.596);
            align-self: flex-end;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            text-decoration: none;
            font-size: large;
            color: black;
        }

        #submit:hover {
            background-color: rgba(72, 158, 244, 0.663);
            color: white;
            scale: 1.04;
            box-shadow: 1px 1px 1px black;
        }

        .icon {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            margin-bottom: 12.5px;
        }

        #expand-link {
            text-decoration: none;
            font-size: large;
            color: black;
            align-self: flex-end;
        }

        #expand-link:hover {
            text-decoration: underline;
            color: red;
            scale: 1.2;
        }

        .cyan {
            background-color: cyan;
        }

        .disabled-link {
            color: gray;
            cursor: not-allowed;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <h1>Take Quiz</h1>
    <div class="container">
        <% let index=0; %>
            <% questions.forEach((question, index)=> { %>
                <% const is_submitted=submittedQuestionIds.has(question._id.toString());%>
                    <div class="box">
                        <% if (is_submitted) { %>
                            <span class="disabled-link">Already Submitted</span>
                            <% } else{%>
                                <p><strong>Question <%= index + 1 %>:</strong>
                                    <%= question.questionText %>
                                </p>
                                <a href="/quiz/question/<%=question._id%>/<%=practiceSession._id%>" id="expand-link">
                                    <div class="icon"><span>expand</span><svg xmlns="http://www.w3.org/2000/svg"
                                            height="24px" viewBox="0 -960 960 960" width="24px" fill="#EA3323">
                                            <path
                                                d="M120-120v-200h80v120h120v80H120Zm520 0v-80h120v-120h80v200H640ZM120-640v-200h200v80H200v120h-80Zm640 0v-120H640v-80h200v200h-80Z" />
                                        </svg></div>
                                </a>
                                <%}%>
                    </div>
                    <hr>
                    <% index++; }); %>
                        <a href="/submit/quiz/<%=practiceSession._id%>" id="submit">submit quiz</a>
    </div>
</body>

</html>