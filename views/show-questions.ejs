<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show questions</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        #link {
            text-decoration: none;
            font-size: 1.2rem;
            margin-bottom: 20px;
            display: inline-block;
            margin-right: 50%;
        }

        #link:hover {
            text-decoration: underline;
            color: #357ABD;
        }

        #delete-btn {
            text-decoration: none;
            font-size: 1rem;
            margin-bottom: 10px;
            display: inline-block;
            background-color: #ff4d4d;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            margin-left: 95%;
        }

        .box {
            width: 40vw;
            margin-bottom: 15px;
            padding: 1.5% 10%;
            background-color: #e0e0e0;
            border-radius: 5px;
            border: 1px solid black;
        }
    </style>
</head>

<body>
    <h1>Show Questions</h1>
    <a href="/back-to-admin-panel" id="link">
        << back to admin panel</a>
            <% for(question of questions) { %>
                <div class="box">
                    <a href="/delete/question/<%= question._id %>" id="delete-btn">Delete</a>
                    <h3>Question ID: <%= question._id %>
                    </h3>
                    <p><strong>difficulty:</strong>
                        <%= question.difficulty %>
                    </p>
                    <p><strong>Question Text:</strong>
                        <%= question.questionText %>
                    </p>
                    <p><strong>Options:</strong></p>


                    <p><strong>Option A:</strong>
                        <%= question.optionA %>
                    </p>
                    <p><strong>Option B:</strong>
                        <%= question.optionB %>
                    </p>
                    <p><strong>Option C:</strong>
                        <%= question.optionC %>
                    </p>
                    <p><strong>Option D:</strong>
                        <%= question.optionD %>
                    </p>


                    <p><strong>Correct Answer:</strong>
                        <%= question.correctAnswer %>
                    </p>
                    <p><strong>interviewType:</strong>
                        <%= question.interviewType %>
                    </p>
                    <p><strong>companyTags:</strong>
                        <%= question.companyTags %>
                    </p>
                    <p><strong>technologyTags:</strong>
                        <%= question.technologyTags %>
                    </p>

                </div>
                <% } %>
</body>

</html>