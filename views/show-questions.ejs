<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show questions</title>
    <style>
        :root {
    --primary: #4A90E2;
    --primary-dark: #357ABD;
    --danger: #ef4444;
    --danger-dark: #dc2626;
    --bg: #f4f6fb;
    --card-bg: #ffffff;
    --text-dark: #1f2933;
    --text-light: #6b7280;
    --border: #e5e7eb;
    --shadow: 0 18px 40px rgba(0, 0, 0, 0.1);
}

* {
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    margin: 0;
    padding: 30px 20px;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f9fafb);
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text-dark);
}

/* Page title */
h1 {
    margin-bottom: 20px;
    font-size: 2rem;
    font-weight: 600;
}

/* Back link */
#link {
    align-self: flex-start;
    margin-bottom: 30px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
}

#link:hover {
    text-decoration: underline;
}

/* Question card */
.box {
    width: 100%;
    max-width: 900px;
    margin-bottom: 25px;
    padding: 22px 26px;
    background: var(--card-bg);
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 14px;
    animation: fadeIn 0.4s ease;
}

/* Delete button */
#delete-btn {
    align-self: flex-end;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--danger), var(--danger-dark));
    color: white;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#delete-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 18px rgba(239, 68, 68, 0.4);
}

/* Question content */
.ques_box {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

/* Text styling */
.ques_box h3 {
    margin: 0 0 6px 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-dark);
}

.ques_box p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--text-light);
}

.ques_box strong {
    color: var(--text-dark);
}

/* Fade animation */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@media (max-width: 700px) {
    h1 {
        font-size: 1.6rem;
    }

    .box {
        padding: 18px 20px;
    }
}

    </style>
</head>

<body>
    <h1>Show Questions</h1>
    <a href="/back-to-admin-panel" id="link">
        << back to admin panel</a>
            <% for(question of questions) { %>
                <div class="box">
                    <a href="/delete/question/<%= question._id %>" id="delete-btn">Delete</a>
                    <div class="ques_box">
                        <h3>Question ID: <%= question._id %>
                        </h3>
                        <p><strong>difficulty:</strong>
                            <%= question.difficulty %>
                        </p>
                        <p><strong>Question Text:</strong>
                            <%= question.questionText %>
                        </p>
                        <p><strong>Options:</strong></p>


                        <p><strong>Option A:</strong>
                            <%= question.optionA %>
                        </p>
                        <p><strong>Option B:</strong>
                            <%= question.optionB %>
                        </p>
                        <p><strong>Option C:</strong>
                            <%= question.optionC %>
                        </p>
                        <p><strong>Option D:</strong>
                            <%= question.optionD %>
                        </p>


                        <p><strong>Correct Answer:</strong>
                            <%= question.correctAnswer %>
                        </p>
                        <p><strong>interviewType:</strong>
                            <%= question.interviewType %>
                        </p>
                        <p><strong>companyTags:</strong>
                            <%= question.companyTags %>
                        </p>
                        <p><strong>technologyTags:</strong>
                            <%= question.technologyTags %>
                        </p>
                    </div>


                </div>
                <% } %>
</body>

</html>