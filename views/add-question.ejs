<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Question</title>
    <style>
        :root {
    --primary: #4A90E2;
    --primary-dark: #357ABD;
    --bg: #f4f6fb;
    --card-bg: #ffffff;
    --text-dark: #2c3e50;
    --text-light: #6b7280;
    --border: #e5e7eb;
    --success: #33f446;
}

* {
    box-sizing: border-box;
}

body {
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f9fafb);
    min-height: 100vh;
    margin: 0;
    padding: 30px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--text-dark);
}

/* Heading */
h1 {
    margin-bottom: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* Back link */
#link {
    align-self: flex-start;
    margin-left: 5%;
    margin-bottom: 15px;
    text-decoration: none;
    font-size: 1rem;
    color: var(--primary);
    transition: color 0.2s ease;
}

#link:hover {
    color: var(--primary-dark);
    text-decoration: underline;
}

/* Toggle box */
#toggle-box {
    position: absolute;
    top: 20px;
    right: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
}

#type {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-light);
}

/* Toggle button */
#toggleBtn {
    width: 52px;
    height: 26px;
    background-color: #c7c7ff;
    border-radius: 13px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 2px;
    transition: background-color 0.3s ease;
}

#circle {
    width: 22px;
    height: 22px;
    background-color: var(--primary);
    border-radius: 50%;
    transition: transform 0.3s ease;
}

/* Form Card */
form {
    width: 55vw;
    min-width: 360px;
    max-width: 900px;
    background-color: var(--card-bg);
    padding: 30px 40px;
    border-radius: 14px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    gap: 18px;
    animation: fadeIn 0.5s ease;
}

/* Form rows */
.box {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* Labels */
label {
    width: 40%;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-dark);
    text-align: right;
}

/* Inputs & selects */
input[type="text"],
select {
    flex: 1;
    padding: 10px 12px;
    font-size: 0.95rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    outline: none;
    transition: border 0.2s ease, box-shadow 0.2s ease;
}

input[type="text"]:focus,
select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}

/* Options group */
#options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 15px;
    border-radius: 10px;
    background: #f9fafb;
    border: 1px dashed var(--border);
}

/* Button */
button {
    margin-top: 10px;
    align-self: center;
    padding: 12px 26px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.4px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgba(74, 144, 226, 0.3);
}

button:active {
    transform: translateY(0);
    box-shadow: none;
}

/* Dropdown sizing */
#difficulty,
#interviewType {
    max-width: 220px;
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@media (max-width: 768px) {
    form {
        width: 90vw;
        padding: 25px 20px;
    }

    .box {
        flex-direction: column;
        align-items: flex-start;
    }

    label {
        width: 100%;
        text-align: left;
    }

    #toggle-box {
        position: static;
        margin-bottom: 15px;
    }
}

    </style>
</head>

<body>
    <h1>Add Question Page</h1>
    <a href="/back-to-admin-panel" id="link">
        << back to admin panel</a>

            <div id="toggle-box">
                <button id="toggleBtn">
                    <div id="circle"></div>
                </button>
                <h2 id="type">MCQ</h2>
            </div>

            <form action="/admin/add-question" method="POST">
                <div class="box">
                    <label for="questionText">Question Text:</label><br>
                    <input type="text" id="questionText" name="questionText" required><br><br>
                </div>

                <div class="box">
                    <label for="difficulty">Difficulty:</label><br>
                    <select id="difficulty" name="difficulty" required>
                        <option value="">--select--</option>
                        <option value="beginner">beginner</option>
                        <option value="intermediate">intermediate</option>
                        <option value="advanced">advanced</option>
                    </select>
                </div>
                <div id="options">
                    <div class="box">
                        <label for="optionA">Option A:</label><br>
                        <input type="text" id="optionA" name="optionA" required><br><br>
                    </div>

                    <div class="box">
                        <label for="optionB">Option B:</label><br>
                        <input type="text" id="optionB" name="optionB" required><br><br>
                    </div>

                    <div class="box">
                        <label for="optionC">Option C:</label><br>
                        <input type="text" id="optionC" name="optionC" required><br><br>
                    </div>

                    <div class="box">
                        <label for="optionD">Option D:</label><br>
                        <input type="text" id="optionD" name="optionD" required><br><br>
                    </div>
                </div>


                <div class="box">
                    <label for="correctAnswer">Correct Answer (A/B/C/D):</label><br>
                    <input type="text" id="correctAnswer" name="correctAnswer" required><br><br>
                </div>

                <div class="box">
                    <label for="interviewType">Interview Type:</label><br>
                    <select name="interviewType" id="interviewType">
                        <option value="">--select--</option>
                        <option value="technical">Technical</option>
                        <option value="behavioral">Behavioral</option>
                        <option value="managerial">Managerial</option>
                        <option value="case-study">case-study</option>
                    </select><br><br>
                </div>

                <div class="box">
                    <label for="companyTags">Company Tags (comma separated):</label><br>
                    <input type="text" id="companyTags" name="companyTags" required><br><br>
                </div>

                <div class="box">
                    <label for="technologyTags">Technology Tags (comma separated):</label><br>
                    <input type="text" id="technologyTags" name="technologyTags" required><br><br>
                </div>
                <input type="hidden" name="answerType" id="answerType" value="mcq">

                <div class="box">
                    <label for="explanation">Explanation:</label><br>
                    <input type="text" id="explanation" name="explanation"><br><br>
                </div>

                <button>Add Question</button>
            </form>

            <script>
                const circle = document.getElementById('circle');
                const button = document.getElementById('toggleBtn');
                const type = document.getElementById('type');
                const options = document.getElementById('options');
                const optionA = document.getElementById('optionA');
                const optionB = document.getElementById('optionB');
                const optionC = document.getElementById('optionC');
                const optionD = document.getElementById('optionD');
                const answerType = document.getElementById('answerType');

                let isToggled = false;

                circle.addEventListener('click', () => {
                    isToggled = !isToggled;
                    if (isToggled) {
                        circle.style.transform = 'translateX(27px)';
                        button.style.backgroundColor = 'rgb(51, 244, 70)';
                        type.textContent = 'TXT';
                        optionA.type = 'hidden';
                        optionB.type = 'hidden';
                        optionC.type = 'hidden';
                        optionD.type = 'hidden';
                        options.style.display = 'none';
                        answerType.value = 'text';
                    } else {
                        circle.style.transform = 'translateX(0)';
                        button.style.backgroundColor = '#8686ef';
                        type.textContent = 'MCQ';
                        options.style.display = 'flex';
                        optionA.type = 'text';
                        optionB.type = 'text';
                        optionC.type = 'text';
                        optionD.type = 'text';
                        answerType.value = 'mcq';
                    }
                });
            </script>
</body>

</html>