<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show detailed result</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f0f0f0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        #link {
            text-decoration: none;
            font-size: 1.2rem;
            margin-bottom: 20px;
            display: inline-block;
        }

        #link:hover {
            text-decoration: underline;
            color: #357ABD;
        }

        .box {
            width: 40vw;
            margin-bottom: 15px;
            padding: 1.5% 10%;
            background-color: #e0e0e0;
            border-radius: 5px;
            border: 1px solid black;
            min-width: 260px;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
        }

        .container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: 100%;
        }

        #show-btn {
            text-decoration: none;
            font-size: 1rem;
            margin-bottom: 10px;
            display: inline-block;
            background-color: #ff4d4d;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            width: 130px;
            text-align: center;
            align-self: flex-end;
        }

        .bg-correct {
            background-color: green;
        }

        .bg-wrong {
            background-color: red;
        }
    </style>
</head>

<body>
    <h1>Your Results</h1>
    <h3>RESULT ID: <%= result._id %>
    </h3>
    <div class="container">
        <% for(let i=0 ; i < questions.length ; i++) { %>

            <% const question=questions[i] %>
                <% const submission=submissions[i] %>

                    <div class="box">
                        <p><strong>Question Id:</strong>
                            <%= question._id %>
                        </p>
                        <p><strong>Question :</strong>
                            <%= question.questionText %>
                        </p>

                        <p class="<%=submission.isCorrect?'bg-correct':'bg-wrong'%>"><strong>Your Answer
                                :</strong>
                            <%= submission.userAnswer %>
                        </p>
                        <p><strong>correct Answers:</strong>
                            <%= question.correctAnswer %>
                        </p>
                    </div>
                    <% } %>
    </div>

</body>

</html>