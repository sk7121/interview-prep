<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>show detailed result</title>
  <style>
    :root {
      --primary: #4A90E2;
      --success: #22c55e;
      --danger: #ef4444;
      --bg: #f4f6fb;
      --card-bg: #ffffff;
      --text-dark: #1f2933;
      --text-light: #6b7280;
      --border: #e5e7eb;
      --shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 30px 20px;
      font-family: "Inter", "Segoe UI", Arial, sans-serif;
      background: linear-gradient(135deg, #eef2ff, #f9fafb);
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--text-dark);
    }

    /* Page headings */
    h1 {
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 5px;
    }

    h3 {
      margin-top: 0;
      margin-bottom: 30px;
      font-weight: 500;
      color: var(--text-light);
    }

    /* Back link */
    #link {
      align-self: flex-start;
      margin-bottom: 20px;
      text-decoration: none;
      font-size: 1rem;
      color: var(--primary);
      font-weight: 600;
    }

    #link:hover {
      text-decoration: underline;
    }

    /* Container */
    .container {
      width: 100%;
      max-width: 900px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    /* Result card */
    .box {
      width: 100%;
      padding: 22px 26px;
      background: var(--card-bg);
      border-radius: 16px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 10px;
      animation: fadeIn 0.4s ease;
    }

    /* Text */
    .box p {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* Correct / Wrong badge */
    .bg-correct,
    .bg-wrong {
      margin-top: 8px;
      padding: 8px 12px;
      border-radius: 10px;
      color: white;
      font-weight: 600;
      width: fit-content;
    }

    .bg-correct {
      background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .bg-wrong {
      background: linear-gradient(135deg, #ef4444, #dc2626);
    }

    /* Animation */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Responsive */
    @media (max-width: 600px) {
      h1 {
        font-size: 1.6rem;
      }

      .box {
        padding: 18px 20px;
      }
    }
  </style>
</head>

<body>
  <h1>Your Results</h1>
  <h3>Result ID: <%= result._id %></h3>

  <div class="container">
    <% submissions.forEach(sub => { %>
    <div class="box">
      <p><strong>Question:</strong>
        <%= sub.questionId ? sub.questionId.questionText : "Question deleted by admin!" %>
      </p>

      <p class="<%= sub.isCorrect ? 'bg-correct' : 'bg-wrong' %>">
        <strong>Your Answer:</strong> <%= sub.questionId? sub.userAnswer : "" %>
      </p>

      <p>
        <strong>Correct Answer:</strong>
        <%= sub.questionId? sub.questionId.correctAnswer :"" %>
      </p>
    </div>
    <% }) %>
  </div>
</body>


</html>