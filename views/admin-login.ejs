<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin-Login</title>
    <style>
        :root {
    --primary: #4A90E2;
    --primary-dark: #357ABD;
    --bg: #f4f6fb;
    --card-bg: #ffffff;
    --text-dark: #1f2933;
    --text-light: #6b7280;
    --danger: #ff4d4d;
    --danger-dark: #e60000;
    --border: #e5e7eb;
    --shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
}

* {
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    margin: 0;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    background: linear-gradient(135deg, #eef2ff, #f9fafb);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-dark);
}

/* Page title */
h1 {
    margin-bottom: 20px;
    font-size: 2rem;
    font-weight: 600;
}

/* Login Card */
#admin-login-form {
    width: 50vw;
    min-width: 360px;
    max-width: 520px;
    padding: 40px 35px;
    background: var(--card-bg);
    border-radius: 14px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: fadeIn 0.5s ease;
}

/* Form rows */
#admin-login-form .box {
    display: flex;
    align-items: center;
    gap: 16px;
}

/* Labels */
#admin-login-form label {
    width: 40%;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-light);
    text-align: right;
}

/* Inputs */
#admin-login-form input {
    flex: 1;
    padding: 10px 12px;
    font-size: 0.95rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    outline: none;
    transition: border 0.2s ease, box-shadow 0.2s ease;
}

#admin-login-form input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}

/* Login button */
#admin-login-btn {
    margin-top: 10px;
    align-self: center;
    width: 9rem;
    height: 2.8rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border: none;
    cursor: pointer;
    letter-spacing: 0.4px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#admin-login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(74, 144, 226, 0.35);
}

#admin-login-btn:active {
    transform: translateY(0);
    box-shadow: none;
}

/* Back link */
#logout-link {
    position: absolute;
    top: 25px;
    right: 25px;
    padding: 8px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--danger), var(--danger-dark));
    color: white;
    text-decoration: none;
    box-shadow: 0 10px 20px rgba(255, 77, 77, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#logout-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 30px rgba(255, 77, 77, 0.45);
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Responsive */
@media (max-width: 600px) {
    h1 {
        font-size: 1.6rem;
    }

    #admin-login-form {
        width: 90vw;
        padding: 30px 22px;
    }

    #admin-login-form .box {
        flex-direction: column;
        align-items: flex-start;
    }

    #admin-login-form label {
        width: 100%;
        text-align: left;
    }

    #logout-link {
        position: static;
        margin-bottom: 20px;
        align-self: flex-end;
    }
}

    </style>
</head>

<body>
    <h1>Admin Login</h1>
    <form action="/admin/home" method="post" id="admin-login-form">
        <div class="box">
            <label for="admin-username">Admin Name:</label>
            <input type="text" id="admin-username" name="admin-username" required>
        </div>

        <div class="box">
            <label for="admin-email">Admin Email:</label>
            <input type="email" id="admin-email" name="admin-email" required>
        </div>

        <div class="box">
            <label for="admin-password">Admin Password:</label>
            <input type="password" id="admin-password" name="admin-password" required>
        </div>
        <button type="submit" id="admin-login-btn">Login</button>
        <a href="/" id="logout-link">
            << back to login </a>

</body>

</html>